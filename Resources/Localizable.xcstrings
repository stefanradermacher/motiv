    "Den Ordner dieses Bildes freigeben, um alle Bilder darin zu sehen. Motiv merkt sich die Freigabe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant access to this image’s folder to see all images in it. Motiv remembers the permission."
          }
        }
      }
    },
    "Der Hinweis für sensible Inhalte ist in den Systemeinstellungen eingeschaltet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive Content Warning is switched on in System Settings."
          }
        }
      }
    },
