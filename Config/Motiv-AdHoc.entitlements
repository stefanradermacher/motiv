<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Für Builds ohne Entwicklerkonto (build.sh ohne Team-ID): wie Motiv.entitlements, aber ohne die
	     Prüfung sensibler Inhalte, die ein Provisioning-Profil verlangt. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Nur Lesen in selbst gewählten Ordnern: Motiv ist ein reiner Betrachter und schreibt
	     keine Datei; Bearbeiten und Umwandeln übernehmen Vorschau und andere Programme. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Die freigegebenen Ordner und Favoriten über einen Neustart hinweg behalten. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
