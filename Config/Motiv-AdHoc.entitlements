<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Für Builds ohne Entwicklerkonto (build.sh ohne Team-ID): wie Motiv.entitlements, aber ohne die
	     Prüfung sensibler Inhalte, die ein Provisioning-Profil verlangt. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Lesen in selbst gewählten Ordnern; Schreiben nur dorthin, wo beim Exportieren
	     ausdrücklich ein Ziel gewählt wird. Motiv ändert keine vorhandenen Dateien. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Die freigegebenen Ordner und Favoriten über einen Neustart hinweg behalten. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
