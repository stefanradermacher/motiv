<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Nur Lesen in selbst gewählten Ordnern: Motiv ändert keine Datei. Erst ein Export in ein
	     ausdrücklich gewähltes Ziel bräuchte wieder read-write. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Die freigegebenen Ordner und Favoriten über einen Neustart hinweg behalten. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Hinweis für sensible Inhalte: Bilder auf dem Mac auf Nacktheit prüfen, wenn der Hinweis
	     in den Systemeinstellungen eingeschaltet ist. -->
	<key>com.apple.developer.sensitivecontentanalysis.client</key>
	<array>
		<string>analysis</string>
	</array>
</dict>
</plist>
